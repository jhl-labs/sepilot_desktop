{
  "manifest_version": 3,
  "name": "SEPilot Browser Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "description": "Share one selected browser tab with SEPilot Desktop and take control at any time.",
  "permissions": ["debugger", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "SEPilot Browser Companion" }
}
