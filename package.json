{
  "name": "sepilot-desktop",
  "version": "1.0.10",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Sepilot-Source-Available-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhl-labs/sepilot_desktop.git"
  },
  "description": "Sepilot desktop app",
  "scripts": {
    "build": "turbo build --filter=@sepilotd/desktop...",
    "dev": "turbo dev --filter=@sepilotd/daemon --filter=@sepilotd/desktop --concurrency 20",
    "typecheck": "turbo typecheck --filter=@sepilotd/desktop...",
    "clean": "turbo clean",
    "dist:linux": "pnpm --dir packages/desktop run dist:linux",
    "dist:mac": "pnpm --dir packages/desktop run dist:mac",
    "dist:win": "pnpm --dir packages/desktop run dist:win"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
