  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "image-size@1.2.1": "sepilot-cli/patches/image-size@1.2.1.patch",
      "ssh2@1.17.0": "sepilot-cli/patches/ssh2@1.17.0.patch"
    },
    "allowUnusedPatches": true,
