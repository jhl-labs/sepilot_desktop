{
  "name": "sepilot-desktop",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Sepilot-Source-Available-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhl-labs/sepilot_desktop.git"
  },
  "description": "Sepilot desktop app",
  "scripts": {
    "build": "turbo build --filter=@sepilotd/desktop...",
    "dev": "turbo dev --filter=@sepilotd/daemon --filter=@sepilotd/desktop --concurrency 20",
    "typecheck": "turbo typecheck --filter=@sepilotd/desktop...",
    "clean": "turbo clean",
    "dist:linux": "pnpm --dir packages/desktop run dist:linux",
    "dist:mac": "pnpm --dir packages/desktop run dist:mac",
    "dist:win": "pnpm --dir packages/desktop run dist:win"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "4.2.0",
    "esbuild": "0.28.1",
    "javascript-obfuscator": "5.4.2",
    "turbo": "2.9.14",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "image-size@1.2.1": "sepilot-cli/patches/image-size@1.2.1.patch",
      "ssh2@1.17.0": "sepilot-cli/patches/ssh2@1.17.0.patch"
    },
    "allowUnusedPatches": true,
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron",
      "node-pty"
    ],
    "overrides": {
      "undici@7.29.0": "7.29.1",
      "undici@6.28.0": "6.28.1",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@xmldom/xmldom@0.8.12": "0.8.15",
      "brace-expansion@1.1.13": "1.1.20",
